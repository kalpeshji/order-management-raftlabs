datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role      String   @default("USER") // "USER" | "ADMIN"
  address   String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model MenuItem {
  id          String      @id @default(cuid())
  name        String
  description String
  price       Float
  image       String
  category    String      @default("PIZZA") // "PIZZA" | "BURGERS" | "PASTA" | "SIDES" | "BEVERAGES" | "DESSERTS"
  isAvailable Boolean     @default(true)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([category])
}

model Order {
  id              String           @id @default(cuid())
  orderNumber     String           @unique
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  customerName    String
  customerPhone   String
  deliveryAddress String
  deliveryNotes   String?
  status          String           @default("ORDER_RECEIVED") // "ORDER_RECEIVED" | "PREPARING" | "OUT_FOR_DELIVERY" | "DELIVERED" | "CANCELLED"
  subtotal        Float
  tax             Float
  deliveryFee     Float
  total           Float
  items           OrderItem[]
  statusHistory   OrderStatusLog[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  unitPrice  Float
  itemTotal  Float

  @@index([orderId])
}

model OrderStatusLog {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  timestamp DateTime @default(now())

  @@index([orderId])
}
